# Cloudflare R2 (S3-compatible storage) — from your R2 bucket + API token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Admin login — generate ADMIN_PASSWORD_HASH with `node scripts/generate-admin-secrets.mjs`
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin/gallery session tokens (32+ random bytes)
JWT_SECRET=

# Secret you choose yourself; checked against the cron request's Authorization header
CRON_SECRET=
